<page>
	<page-action name="PageValue.loadPageVariable" bean="numberutils" class="org.openedit.util.MathUtils"/>

 	<path-action name="ChatModule.loadChatChannel" />
	<path-action name="AgentModule.loadAgentContext" />
	
	<permission name="editcollection">
		<or>
			<action name="ProjectModule.canEditCollection" />
			<action name="ProjectModule.isOnTeam" />
		</or>
	</permission>
</page>