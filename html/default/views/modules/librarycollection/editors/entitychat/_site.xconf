<page>

	<property name="edithomename">entitychat</property>

	<property name="fallbackdirectory">/${applicationid}/views/modules/default/editors/entitychat</property>

	<page-action name="EntityModule.getEntity"/>
	<page-action name="ChatModule.loadChatChannel" />
	<page-action name="AgentModule.loadAgentContext" />

	<property name="chatterboxhomeX">${edithome}/chatterbox</property>

	<property name="channeltype">emeteamchat</property>
	<property name="defaultscenarioid">team_chat_monitor</property>

</page>